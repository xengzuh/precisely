# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Supabase — project URL and anon key from Dashboard → Settings → API.
# The anon key is safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely, so it is server-only and must never
# carry a NEXT_PUBLIC_ prefix. Used only by agent runs, which have no user
# session; on that path org_id filtering is application code.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Server-only. Without it the app runs but the intake agent is
# disabled and says so.
ANTHROPIC_API_KEY=

# Optional: override the model for testing. Defaults to claude-opus-5.
# claude-sonnet-5 and claude-haiku-4-5 also work; effort and pricing adapt.
# ANTHROPIC_MODEL=

# Which organization unattended agent work belongs to. Required by every
# channel — WhatsApp and inbound email both run on the service role with no
# RLS, so the org is read from server config and never from the payload.
AGENT_ORG_ID=

# Only needed for the inbound email webhook, which verifies an HMAC over the
# request body with this. WhatsApp does not use it.
INBOUND_WEBHOOK_SECRET=

# WhatsApp via the Meta Cloud API — the direct route, and the one in use.
# Without these the review inbox still works: drafts are approved and copied
# into WhatsApp by hand, which is a supported state rather than a broken one.
#
# From developers.facebook.com → your app → WhatsApp → API Setup. The test
# number is free and delivers only to recipients you add to its allow list.
# The app must also be subscribed to the WABA, which is separate from adding
# the webhook — POST /{waba-id}/subscribed_apps. Miss that and the callback
# verifies, the dashboard shows deliveries, and nothing ever reaches you.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=         # a System User token does not expire in 24h
WHATSAPP_APP_SECRET=           # signs X-Hub-Signature-256 over the raw body
WHATSAPP_VERIFY_TOKEN=         # any string; Meta echoes it on the GET handshake

# Alternative: WhatsApp via Twilio. Meta wins if both are set.
# The sandbox (Console → Messaging → Try it out) needs no business verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=          # e.g. whatsapp:+14155238886 for the sandbox
# The public URL Twilio posts to — it signs that URL, so behind a tunnel the
# app's own view of the request (localhost) will not verify.
WHATSAPP_PUBLIC_URL=           # e.g. https://abc123.trycloudflare.com/api/whatsapp
