# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# Supabase — project URL and anon key from Dashboard → Settings → API.
# The anon key is safe in the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses RLS entirely, so it is server-only and must never
# carry a NEXT_PUBLIC_ prefix. Used only by agent runs, which have no user
# session; on that path org_id filtering is application code.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic. Server-only. Without it the app runs but the intake agent is
# disabled and says so.
ANTHROPIC_API_KEY=

# Optional: override the model for testing. Defaults to claude-opus-5.
# claude-sonnet-5 and claude-haiku-4-5 also work; effort and pricing adapt.
# ANTHROPIC_MODEL=

# Optional: enables the inbound email webhook. The secret verifies an HMAC over
# the request body. INBOUND_ORG_ID is which organization inbound mail belongs
# to — deliberately server config, never read from the request payload, since
# that path runs on the service role with no RLS.
INBOUND_WEBHOOK_SECRET=
INBOUND_ORG_ID=
